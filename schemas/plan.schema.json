{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "product_name",
    "objective",
    "users",
    "problems",
    "features",
    "constraint_responses",
    "assumptions",
    "metrics",
    "out_of_scope",
    "open_questions",
    "rollout"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "product_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "basis"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000,
          "pattern": "\\S"
        },
        "basis": {
          "$ref": "#/$defs/basis"
        }
      }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "job",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "job": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "basis": {
            "$ref": "#/$defs/basis"
          }
        }
      },
      "minItems": 1,
      "maxItems": 30
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "user_ids",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "user_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 30
          },
          "basis": {
            "$ref": "#/$defs/basis"
          }
        }
      },
      "minItems": 1,
      "maxItems": 60
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "problem_ids",
          "scope",
          "priority",
          "priority_rationale",
          "basis",
          "dependencies",
          "subfeatures",
          "stories"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "problem_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 60
          },
          "scope": {
            "enum": [
              "mvp",
              "later"
            ]
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "could"
            ]
          },
          "priority_rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "basis": {
            "$ref": "#/$defs/basis"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 60
          },
          "subfeatures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "description"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "\\S"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3000,
                  "pattern": "\\S"
                }
              }
            },
            "minItems": 1,
            "maxItems": 30
          },
          "stories": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "user_id",
                "want",
                "benefit",
                "acceptance"
              ],
              "properties": {
                "user_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "\\S"
                },
                "want": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3000,
                  "pattern": "\\S"
                },
                "benefit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3000,
                  "pattern": "\\S"
                },
                "acceptance": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "given",
                      "when",
                      "then"
                    ],
                    "properties": {
                      "given": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 3000,
                        "pattern": "\\S"
                      },
                      "when": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 3000,
                        "pattern": "\\S"
                      },
                      "then": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 3000,
                        "pattern": "\\S"
                      }
                    }
                  },
                  "minItems": 1,
                  "maxItems": 30
                }
              }
            },
            "minItems": 1,
            "maxItems": 30
          }
        }
      },
      "minItems": 1,
      "maxItems": 60
    },
    "constraint_responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "treatment",
          "implementation",
          "feature_ids"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "\\S"
          },
          "treatment": {
            "enum": [
              "honored",
              "deferred",
              "needs_decision"
            ]
          },
          "implementation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "feature_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 60
          }
        }
      },
      "minItems": 0,
      "maxItems": 100
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "validation",
          "impact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "\\S"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "validation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "impact": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      },
      "minItems": 0,
      "maxItems": 60
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "definition",
          "baseline",
          "target",
          "target_status",
          "collection",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "outcome",
              "guardrail"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "baseline": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "target": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_status": {
            "enum": [
              "proposed",
              "provided",
              "unknown"
            ]
          },
          "collection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "basis": {
            "$ref": "#/$defs/basis"
          }
        }
      },
      "minItems": 2,
      "maxItems": 30
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "reason",
          "basis"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "basis": {
            "$ref": "#/$defs/basis"
          }
        }
      },
      "minItems": 0,
      "maxItems": 60
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 60
    },
    "rollout": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "feature_ids",
          "exit_criteria"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "feature_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 60
          },
          "exit_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3000,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 30
          }
        }
      },
      "minItems": 1,
      "maxItems": 60
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_refs",
        "assumption_ids"
      ],
      "properties": {
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "quote"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "pattern": "\\S"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000,
                "pattern": "\\S"
              }
            }
          },
          "minItems": 0,
          "maxItems": 30
        },
        "assumption_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 30
        }
      }
    }
  }
}
