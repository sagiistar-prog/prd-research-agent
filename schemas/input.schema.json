{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirement_markdown"
  ],
  "properties": {
    "requirement_markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30000,
      "pattern": "\\S"
    },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "positioning",
          "strengths",
          "weaknesses",
          "pricing",
          "target_user"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "positioning": {
            "type": "string",
            "maxLength": 3000
          },
          "strengths": {
            "type": "string",
            "maxLength": 3000
          },
          "weaknesses": {
            "type": "string",
            "maxLength": 3000
          },
          "pricing": {
            "type": "string",
            "maxLength": 3000
          },
          "target_user": {
            "type": "string",
            "maxLength": 3000
          }
        }
      },
      "minItems": 0,
      "maxItems": 30
    },
    "product_plan": {
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
