{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "prd-revision-comparison"
    },
    "before_snapshot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "after_snapshot": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "product_name": {
      "type": "string"
    },
    "inputs_changed": {
      "type": "boolean"
    },
    "feature_order_changed": {
      "type": "boolean"
    },
    "before_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "after_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "modified"
      ],
      "properties": {
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "modified": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "name",
          "fields",
          "before",
          "after"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "added",
              "removed",
              "modified"
            ]
          },
          "name": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "before": {
            "type": [
              "object",
              "null"
            ]
          },
          "after": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "before",
          "after"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "before": {},
          "after": {}
        }
      }
    },
    "input_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "before",
          "after"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "before": {},
          "after": {}
        }
      }
    },
    "review_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "reasons"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "approval_status": {
      "const": "not_approved"
    },
    "comparison_scope": {
      "const": "structural_changes_and_conservative_review_candidates"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "before_snapshot",
    "after_snapshot",
    "product_name",
    "inputs_changed",
    "feature_order_changed",
    "before_order",
    "after_order",
    "summary",
    "features",
    "sections",
    "input_changes",
    "review_candidates",
    "approval_status",
    "comparison_scope"
  ]
}
