{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "status": {
          "const": "ok"
        },
        "mode": {
          "const": "offline_template"
        },
        "result": {
          "type": "object",
          "properties": {
            "markdown": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500000
            },
            "summary": {
              "type": "object"
            }
          },
          "required": [
            "markdown",
            "summary"
          ],
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "mode",
        "result",
        "warnings"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30000
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30000
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "status",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
